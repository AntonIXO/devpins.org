---
import { mindZones, cvSummary } from '../data/mind';
import BaseHead from '../components/BaseHead.astro';
import SiteNav from '../components/SiteNav.astro';
import CvRegion from '../components/CvRegion.astro';
import { SITE_AUTHOR } from '../consts';
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Curriculum vitae" description="Anton Ivanov — projects, education, and experience." type="profile" clientRouter={false}/></head>
<body>
<div class="site-header"><SiteNav/></div>
<main>
<h1 class="sr-only">{SITE_AUTHOR} — Curriculum vitae</h1>
<section class="world" aria-label="Interactive project map">
 <div class="viewport"><canvas id="mind-canvas" aria-label="Three-dimensional brain. Drag to rotate. Use region buttons to explore."></canvas><div id="hotspots" aria-label="Brain regions"></div><p id="scene-status" role="status">Assembling the inner world…</p></div>
 <div class="scene-tools"><button id="rotate" type="button" aria-pressed="false">Pause</button><button id="reset" type="button">Reset ↗</button></div>
 <div class="health"><p id="health-values">Reading vitals…</p><p id="health-source">Fallback</p><svg viewBox="0 0 320 40" role="img" aria-label="Synthetic EEG-style wave driven by HR, HRV and sleep; not measured EEG"><path id="eeg-trace" d="M0 20H320"/></svg><span>EEG-STYLE / SYNTHETIC</span></div>

 <p class="footnote">Drag to rotate · tap a region<span><a href="/mind/LICENSE.txt">Surface credits</a></span></p>
</section>
<div class="cv-panel">
<section id="selection" tabindex="-1" aria-label="Selected CV entry">
 <div id="selected-content">{cvSummary.map(entry=><CvRegion entryId={entry.id}/>)}</div>
 <noscript><style is:inline>html,body{overflow:auto!important}main{display:block!important;height:auto!important}#selected-content{overflow:visible!important}.cv-region{columns:auto!important;height:auto!important}[data-cv-entry][hidden]{display:block!important}</style></noscript>
<div class="reader-controls" aria-label="Content pages"><button id="page-prev" aria-label="Previous page" disabled>←</button><output id="page-count" aria-live="polite">1 / 1</output><button id="page-next" aria-label="Next page" disabled>→</button></div>
</section>
<details id="summary-toggle" open><summary>CV index <span>{cvSummary.length} entries</span></summary>
<nav id="proof" class="cv-summary" aria-label="CV summary"><ol>{cvSummary.map(entry=><li><a href={`#entry-${entry.id}`} data-entry={entry.id} aria-current={entry.id === 'sensorlm' ? 'true' : undefined}><span>{entry.label}</span><span>{mindZones.find(z=>z.id===entry.region)!.number}</span></a></li>)}</ol></nav></details>
</div>
</main>
<script>import '../scripts/mind';</script>
</body></html>
<style>
:global([hidden]){display:none!important}:global(html),:global(body){height:100%;overflow:hidden}.site-header{height:64px;padding:0 var(--page-pad-x);border-bottom:1px solid var(--rule)}.site-header :global(nav){max-width:none;height:100%;padding-top:18px}main{display:grid;grid-template-columns:1fr 1fr;height:calc(100svh - 64px);min-height:0}.world{position:relative;min-width:0;min-height:0;overflow:hidden}.viewport{position:absolute;inset:0}canvas{display:block;width:100%;height:100%;touch-action:none}#hotspots{position:absolute;inset:0;pointer-events:none}#hotspots :global(button){position:absolute;width:32px;height:32px;border:1px solid var(--rule);border-radius:50%;background:var(--paper);color:var(--ink);font:10px var(--font-mono);pointer-events:auto}#hotspots :global(button[aria-pressed=true]){border-color:var(--pulse);color:var(--pulse)}#scene-status{position:absolute;top:45%;width:100%;text-align:center;font:11px var(--font-mono);color:var(--mute)}.scene-tools{position:absolute;right:22px;bottom:20px;z-index:4;display:flex;gap:16px}.scene-tools button{font:10px var(--font-mono);color:var(--mute)}.health{position:absolute;top:24px;left:24px;width:220px;pointer-events:none}.health p{margin:0 0 7px;font:10px var(--font-mono);color:var(--ink)}#health-source{font-size:9px;color:var(--mute)}.health svg{width:100%;height:30px;margin-top:8px}.health path{stroke:var(--pulse);fill:none;stroke-width:1;opacity:.65}.health>span{font:7px var(--font-mono);letter-spacing:.06em;color:var(--mute)}.footnote{position:absolute;bottom:20px;left:24px;display:flex;gap:18px;font:8px var(--font-mono);color:var(--mute);pointer-events:none}.footnote a{pointer-events:auto}.footnote span{display:none}.cv-panel{display:flex;flex-direction:column;min-width:0;min-height:0;border-left:1px solid var(--rule);padding:26px 32px 18px;gap:18px;position:relative}#selection{display:flex;flex-direction:column;flex:1;min-height:0;outline:none}#selected-content{flex:1;min-height:0;overflow:hidden;position:relative;--reader-gap:32px}#selected-content :global(.cv-region){height:100%;width:100%;column-width:var(--reader-width);column-gap:var(--reader-gap);column-fill:auto;margin:0;transform:translateX(0)}#selected-content :global(h2){font-size:clamp(24px,2.4vw,34px);break-after:avoid;margin:14px 0 18px}#selected-content :global(p),#selected-content :global(li),#selected-content :global(h4),#selected-content :global(.award),#selected-content :global(.skills){break-inside:avoid}#selected-content :global(.github-card),#selected-content :global(.cv-embed),#selected-content :global(.link-preview){break-inside:avoid}#selected-content :global(.cv-entry),#selected-content :global(.cv-section),#selected-content :global(.identity){margin-top:18px;padding-top:14px}#selected-content :global(.github-card){padding:12px}#selected-content :global(.repo-list li){padding:7px 0}#selected-content :global(.repo-list){margin:8px 0!important}#selected-content :global(.link-preview img){height:min(160px,calc(var(--reader-height) - 160px))}#selected-content :global(.cv-embed iframe){height:min(300px,calc(var(--reader-height) - 64px));min-height:160px}#selected-content :global(.embed-load){min-height:130px}.reader-controls{display:flex;align-items:center;justify-content:flex-end;gap:18px;padding-top:14px;font:11px var(--font-mono);color:var(--mute)}.reader-controls button{width:32px;height:28px;border:1px solid var(--rule);color:var(--ink)}.reader-controls button:disabled{opacity:.25;cursor:default}#summary-toggle{border-top:1px solid var(--rule);padding-top:13px}#summary-toggle>summary{font:11px var(--font-mono);color:var(--mute);cursor:pointer;display:flex;justify-content:space-between;list-style:none}#summary-toggle>summary::-webkit-details-marker{display:none}#summary-toggle>summary span{font-size:9px}.cv-summary ol{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:0 22px;margin-top:10px}.cv-summary li{border-top:1px solid var(--rule);min-width:0}.cv-summary a{display:flex;justify-content:space-between;gap:8px;padding:8px 0;font-size:12px;line-height:1.35}.cv-summary a>span:last-child{font:9px var(--font-mono);color:var(--mute);align-self:center}.cv-summary a[aria-current=true]{color:var(--pulse)}
@media(max-height:760px) and (min-width:721px){.cv-panel{padding-top:18px;gap:10px}.cv-summary ol{grid-template-columns:repeat(3,minmax(0,1fr));gap:0 16px}.cv-summary a{font-size:11px;padding:7px 0}.cv-summary a>span:last-child{display:none}}
@media(max-width:720px){.site-header{height:52px;padding:0 18px}.site-header :global(nav){padding-top:12px}main{height:calc(100svh - 52px);grid-template-columns:1fr;grid-template-rows:32% 68%}.cv-panel{border-left:0;border-top:1px solid var(--rule);padding:16px 20px 12px;gap:10px}.health{top:12px;left:18px;width:170px}.health p{font-size:8px}.health svg{height:18px;margin-top:3px}.health>span,#health-source,.footnote{display:none}.scene-tools{bottom:12px;right:18px}.scene-tools button{font-size:9px}#hotspots :global(button){width:25px;height:25px;font-size:8px}#summary-toggle{padding-top:10px}#summary-toggle[open]{position:absolute;bottom:12px;left:20px;right:20px;background:var(--paper);z-index:6;box-shadow:0 -20px 20px var(--paper)}#summary-toggle[open]>summary{padding:10px 0}.cv-summary a{padding:8px 0;font-size:11px}.reader-controls{padding-top:8px;gap:12px}#selected-content :global(.cv-region){font-size:13px;line-height:1.55}#selected-content :global(h2){font-size:26px;margin-top:10px}#selected-content :global(.github-card){break-inside:auto}#selected-content :global(.github-heading){break-after:avoid}#selected-content :global(.repo-list li){break-inside:avoid}}
@media print{:global(html),:global(body){height:auto;overflow:visible}.site-header,.world,.reader-controls,#summary-toggle{display:none}main{display:block;height:auto}.cv-panel{padding:0;border:0}#selected-content{overflow:visible}#selected-content :global(.cv-region){height:auto;columns:auto!important;transform:none!important}#selected-content :global([data-cv-entry][hidden]){display:block!important}}
</style>
