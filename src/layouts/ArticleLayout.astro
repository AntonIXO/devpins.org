---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from './SiteLayout.astro';
import 'katex/dist/katex.min.css';
import '../styles/prose.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, kicker } = Astro.props;
---

<SiteLayout
	title={title}
	description={description}
	image={heroImage}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	wide={false}
	atmosphere="blank"
>
	<article class="article" data-article-title={title}>
		{
			heroImage && (
				<div class="hero">
					<Image
						width={1200}
						densities={[1, 2]}
						src={heroImage}
						alt=""
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)
		}
		<header>
			{kicker && <p class="kicker">{kicker}</p>}
			<p class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="updated">
							Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
		</header>
		<div class="prose">
			<slot />
		</div>
		<dialog class="image-zoom" aria-label="Enlarged image">
			<form method="dialog">
				<button type="submit" aria-label="Close enlarged image">×</button>
			</form>
			<img src="" alt="" />
		</dialog>
		<div class="article-end-sentinel" aria-hidden="true"></div>
	</article>
</SiteLayout>

<script>
	const setupImageZoom = () => {
		const dialog = document.querySelector<HTMLDialogElement>('.image-zoom');
		const enlargedImage = dialog?.querySelector<HTMLImageElement>('img');
		if (!dialog || !enlargedImage || typeof dialog.showModal !== 'function') return;

		for (const image of document.querySelectorAll<HTMLImageElement>('.prose img')) {
			if (image.closest('.image-zoom-trigger, a')) continue;

			const trigger = document.createElement('button');
			trigger.type = 'button';
			trigger.className = 'image-zoom-trigger';
			trigger.setAttribute('aria-label', `Enlarge image${image.alt ? `: ${image.alt}` : ''}`);
			image.before(trigger);
			trigger.append(image);

			trigger.addEventListener('click', () => {
				enlargedImage.alt = image.alt;
				enlargedImage.src = image.currentSrc || image.src;
				enlargedImage.srcset = image.srcset;
				enlargedImage.sizes = 'min(94vw, 1800px)';
				dialog.showModal();
			});
		}

		enlargedImage.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target !== dialog) return;
			const bounds = dialog.getBoundingClientRect();
			const outside =
				event.clientX < bounds.left ||
				event.clientX > bounds.right ||
				event.clientY < bounds.top ||
				event.clientY > bounds.bottom;
			if (outside) dialog.close();
		});
		dialog.addEventListener('close', () => {
			enlargedImage.removeAttribute('src');
			enlargedImage.removeAttribute('srcset');
		});
	};

	let readTracked = false;
	const observer = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			if (entry.isIntersecting && !readTracked) {
				readTracked = true;
				const article = document.querySelector('article.article');
				const title = article?.getAttribute('data-article-title') || document.title;
				try {
					window.umami?.track('article-read-complete', { title });
				} catch {
					// ignore
				}
				observer.disconnect();
			}
		}
	}, { threshold: 0.5 });

	document.addEventListener('astro:page-load', () => {
		setupImageZoom();
		readTracked = false;
		const target = document.querySelector('.article-end-sentinel');
		if (target) {
			observer.observe(target);
		}
	});
</script>

<style>
	.article {
		padding-top: 72px;
		padding-bottom: 48px;
	}

	.hero {
		margin: 0 0 36px;
	}

	.hero :global(img) {
		width: 100%;
		height: auto;
	}

	.image-zoom {
		max-width: none;
		max-height: none;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: visible;
	}

	.image-zoom::backdrop {
		background: rgb(7 7 8 / 0.9);
		backdrop-filter: blur(6px);
	}

	.image-zoom img {
		display: block;
		width: auto;
		height: auto;
		max-width: min(94vw, 1800px);
		max-height: 90vh;
		background: var(--paper);
		box-shadow: 0 24px 72px rgb(0 0 0 / 0.45);
		cursor: zoom-out;
	}

	.image-zoom form {
		position: absolute;
		top: 8px;
		right: 8px;
		z-index: 1;
	}

	.image-zoom button {
		display: grid;
		width: 36px;
		height: 36px;
		padding: 0;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 50%;
		background: rgb(7 7 8 / 0.72);
		color: white;
		font: 24px/1 var(--font-sans);
		cursor: pointer;
	}

	.image-zoom button:focus-visible {
		outline: 2px solid white;
		outline-offset: 2px;
	}

	.kicker,
	.date {
		font-family: var(--font-mono);
		font-size: 12.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--mute);
		margin: 0 0 14px;
	}

	.updated {
		margin-left: 12px;
		text-transform: none;
		letter-spacing: 0;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.03em;
		max-width: 22ch;
		margin: 0 0 36px;
	}

	@media (max-width: 720px) {
		.article {
			padding-top: 48px;
		}
	}
</style>
