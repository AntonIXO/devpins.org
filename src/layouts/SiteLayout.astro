---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import NeuroField from '../components/NeuroField.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article' | 'profile';
	publishedTime?: Date;
	modifiedTime?: Date;
	wide?: boolean;
	atmosphere?: 'field' | 'blank';
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
	type = 'website',
	publishedTime,
	modifiedTime,
	wide = true,
	atmosphere = 'blank',
} = Astro.props;

const field = atmosphere === 'field';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
	</head>
	<body class:list={{ 'has-field': field }}>
		{field && <NeuroField />}
		<div class:list={['page', { wide }]}>
			<SiteNav />
			<main>
				<slot />
			</main>
			<SiteFooter />
		</div>
		<script>
			import '../scripts/page-motion';
		</script>
	</body>
</html>

<style>
	.page {
		position: relative;
		z-index: 1;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		padding: 0 var(--page-pad-x);
	}

	main {
		flex: 1;
		width: 100%;
		max-width: var(--page-max-narrow);
		margin: 0 auto;
	}

	.wide main {
		max-width: var(--page-max);
	}
</style>
