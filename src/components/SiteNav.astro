---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onWriting = path === '/blog' || path.startsWith('/blog/');
const onCv = path === '/cv';
---

<nav class="nav">
	<a class="brand" href="/" data-nav-link data-umami-event="nav-click" data-umami-event-target="home">
		<span class="d">D</span>evPins
	</a>
	<div class="links">
		<a href="/blog/" data-nav-link class:list={{ current: onWriting }} data-umami-event="nav-click" data-umami-event-target="writing">Writing</a>
		<a href="/cv/" data-nav-link class:list={{ current: onCv }} data-umami-event="nav-click" data-umami-event-target="cv">CV</a>
		<button type="button" data-theme-toggle>White</button>
	</div>
</nav>

<script>
	import '../scripts/site-nav';
</script>

<style>
	.nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		width: 100%;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 22px 0 0;
	}

	.brand {
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.brand:hover {
		color: var(--ink);
	}

	.d {
		font-family: var(--font-serif);
	}

	.links {
		display: flex;
		align-items: baseline;
		gap: 18px;
		font-size: 14px;
		color: var(--mute);
	}

	.links a:hover,
	.links button:hover {
		color: var(--ink);
	}

	.links a.current {
		color: var(--ink);
	}

	.links button {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--mute);
	}

	@media print {
		.nav {
			display: none;
		}
	}
</style>
