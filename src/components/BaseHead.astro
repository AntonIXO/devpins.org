---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import {
	SITE_AUTHOR,
	SITE_DESCRIPTION,
	SITE_EMAIL,
	SITE_GITHUB,
	SITE_LOCALE,
	SITE_OG_IMAGE,
	SITE_OG_IMAGE_ALT,
	SITE_TELEGRAM,
	SITE_TITLE,
	SITE_X,
	SITE_X_HANDLE,
	UMAMI_SCRIPT_URL,
	UMAMI_WEBSITE_ID,
} from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article' | 'profile';
	publishedTime?: Date;
	modifiedTime?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image,
	type = 'website',
	publishedTime,
	modifiedTime,
} = Astro.props;
const origin = Astro.site ?? canonicalURL;
const defaultOg = !image;
const ogImage =
	typeof image === 'string'
		? new URL(image, origin)
		: image
			? new URL(image.src, origin)
			: new URL(SITE_OG_IMAGE, origin);
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const ogType = type === 'article' ? 'article' : 'website';
const imageAlt = defaultOg ? SITE_OG_IMAGE_ALT : title;
const articleModified = type === 'article' ? (modifiedTime ?? publishedTime) : undefined;

const person = {
	'@type': 'Person',
	name: SITE_AUTHOR,
	url: origin.href,
	email: SITE_EMAIL,
	jobTitle: 'Applied maths and AI',
	sameAs: [SITE_GITHUB, SITE_TELEGRAM, SITE_X],
};

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: ogImage.href,
				url: canonicalURL.href,
				mainEntityOfPage: canonicalURL.href,
				datePublished: publishedTime?.toISOString(),
				dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
				author: person,
				publisher: { '@type': 'Person', name: SITE_AUTHOR, url: origin.href },
			}
		: type === 'profile'
			? {
					'@context': 'https://schema.org',
					'@type': 'ProfilePage',
					name: pageTitle,
					url: canonicalURL.href,
					mainEntity: person,
				}
			: {
					'@context': 'https://schema.org',
					'@graph': [
						{
							'@type': 'WebSite',
							name: SITE_TITLE,
							url: origin.href,
							description: SITE_DESCRIPTION,
							author: person,
						},
						person,
					],
				};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', origin)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="theme-color" content="#070708" />

<script is:inline>
	(() => {
		const key = 'devpins-theme';
		let theme = 'dark';
		try {
			const stored = localStorage.getItem(key);
			if (stored === 'light' || stored === 'dark') theme = stored;
			else if (window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
		} catch {
			/* private mode */
		}
		document.documentElement.dataset.theme = theme;
	})();
</script>
<script
	is:inline
	defer
	src={UMAMI_SCRIPT_URL}
	data-website-id={UMAMI_WEBSITE_ID}
	data-domains="devpins.org"
></script>
<Font cssVariable="--font-plex-sans" preload />
<Font cssVariable="--font-plex-serif" />
<Font cssVariable="--font-plex-mono" />

<link rel="canonical" href={canonicalURL} />

<title>{pageTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
{defaultOg && <meta property="og:image:width" content="1200" />}
{defaultOg && <meta property="og:image:height" content="630" />}
{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && articleModified && (
	<meta property="article:modified_time" content={articleModified.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_X_HANDLE} />
<meta name="twitter:creator" content={SITE_X_HANDLE} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<ClientRouter />
