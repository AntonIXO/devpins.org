---
import { SITE_AUTHOR, SITE_EMAIL, SITE_GITHUB, SITE_TELEGRAM, SITE_X, SITE_X_HANDLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>© {year} {SITE_AUTHOR}</p>
	<div>
		<a href={`mailto:${SITE_EMAIL}`} data-umami-event="footer-contact-click" data-umami-event-channel="email">{SITE_EMAIL}</a>
		<a href={SITE_X} target="_blank" rel="noopener noreferrer" data-umami-event="footer-contact-click" data-umami-event-channel="x">{SITE_X_HANDLE}</a>
		<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer" data-umami-event="footer-contact-click" data-umami-event-channel="github">GitHub</a>
		<a href={SITE_TELEGRAM} target="_blank" rel="noopener noreferrer" data-umami-event="footer-contact-click" data-umami-event-channel="telegram">Telegram</a>
		<a href="/rss.xml" data-umami-event="footer-rss-click">RSS</a>
	</div>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px 24px;
		width: 100%;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 72px 0 40px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--mute);
	}

	div {
		display: flex;
		gap: 16px;
	}

	a:hover {
		color: var(--ink);
	}

	@media print {
		footer {
			display: none;
		}
	}
</style>
