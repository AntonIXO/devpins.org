---
interface Props {
	size?: number;
	class?: string;
}

const { size = 26, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 120 120"
	aria-hidden="true"
	focusable="false"
>
	<rect x="14" y="14" width="92" height="92" rx="7" fill="none" stroke="currentColor" stroke-width="8"
	></rect>
	<line x1="60" y1="14" x2="60" y2="106" stroke="currentColor" stroke-width="8"></line>
	<circle cx="37" cy="83" r="19" fill="none" stroke="#4ade80" stroke-width="8"></circle>
	<line x1="74" y1="33" x2="74" y2="87" stroke="currentColor" stroke-width="8"></line>
	<line x1="96" y1="33" x2="96" y2="87" stroke="currentColor" stroke-width="8"></line>
	<line x1="74" y1="60" x2="96" y2="60" stroke="currentColor" stroke-width="8"></line>
</svg>
