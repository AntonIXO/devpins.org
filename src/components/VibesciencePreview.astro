---
interface Props {
	data: string;
}

const { data } = Astro.props;
---

<div class="vibescience-preview" data-vibescience-preview aria-hidden="true">
	<div class="preview-canvas" data-vibescience-preview-canvas></div>
	<div class="preview-caption">
		<span>vault graph / hover preview</span>
		<span>715 notes · 1,769 links</span>
	</div>
	<script type="application/json" data-vibescience-preview-data set:html={data}></script>
</div>

<script>
	import { mountVibesciencePreview } from '../scripts/vibescience-preview';

	let cleanup: (() => void) | undefined;
	const mount = () => {
		cleanup?.();
		cleanup = mountVibesciencePreview();
	};

	document.addEventListener('astro:page-load', mount);
	document.addEventListener('astro:before-swap', () => cleanup?.());
	if (document.readyState !== 'loading') mount();
</script>

<style>
	.vibescience-preview {
		position: absolute;
		top: calc(100% + 10px);
		left: 0;
		z-index: 4;
		width: min(380px, calc(100vw - 48px));
		height: 236px;
		overflow: hidden;
		border: 1px solid var(--rule);
		border-radius: 12px;
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		box-shadow: 0 20px 52px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px) scale(0.98);
		transform-origin: top left;
		transition: opacity 180ms ease, visibility 180ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}

	.preview-canvas {
		position: absolute;
		inset: 0;
	}

	.preview-canvas :global(.force-graph-container),
	.preview-canvas :global(canvas) {
		position: absolute !important;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.preview-caption {
		position: absolute;
		left: 12px;
		right: 12px;
		bottom: 10px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.04em;
		color: var(--mute);
		text-transform: uppercase;
		pointer-events: none;
	}

	.preview-caption span:last-child {
		color: var(--pulse);
		white-space: nowrap;
	}

	:global(.vibescience-row:hover) .vibescience-preview,
	:global(.vibescience-row:focus-within) .vibescience-preview {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
	}

	@media (max-width: 720px) {
		.vibescience-preview {
			width: min(360px, calc(100vw - 48px));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.vibescience-preview {
			transition: none;
			transform: none;
		}
	}
</style>
