---
interface Props {
	as?: 'h2' | 'p';
}

const Tag = Astro.props.as ?? 'h2';
---

<div class="section-label">
	<Tag class="section-label__text"><slot /></Tag>
</div>

<style>
	.section-label {
		margin: 56px 0 14px;
	}

	.section-label__text {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--mute);
	}

	@media (max-width: 720px) {
		.section-label {
			margin: 40px 0 12px;
		}
	}
</style>
