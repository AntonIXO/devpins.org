---
interface Props {
	as?: 'h2' | 'p';
}

const Tag = Astro.props.as ?? 'h2';
---

<div class="section-label">
	<Tag class="section-label__text"><slot /></Tag>
	<span class="section-label__rule" aria-hidden="true"></span>
	<slot name="end" />
</div>

<style>
	.section-label {
		display: flex;
		align-items: baseline;
		gap: 16px;
		margin: 96px 0 20px;
	}

	.section-label__text {
		flex: none;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.55);
	}

	.section-label__rule {
		flex: 1;
		height: 1px;
		background: rgba(255, 255, 255, 0.12);
	}

	@media (max-width: 720px) {
		.section-label {
			margin: 64px 0 16px;
		}
	}
</style>
