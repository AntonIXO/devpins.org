---
import SiteNav from '../components/SiteNav.astro';
import { SITE_AUTHOR } from '../consts';

const projects = [
  { id: 'sensorlm', zone: 'CORPUS CALLOSUM', title: 'Sensor Language Models', text: 'Raw biosensor time-series into language. A from-scratch temporal encoder built on the optiHealth data stream.', color: '#f2b84b' },
  { id: 'optihealth', zone: 'MOTOR CORTEX', title: 'optiHealth', text: 'A personal biometric vector database: sleep, EEG, HRV and glucose in one N-of-1 telemetry engine.', color: '#ef6d73' },
  { id: 'dreamwalker', zone: 'VISUAL CORTEX', title: 'Dream Walker', text: 'A shared dream mystery run by local reasoning agents. One server, one dream, one secret.', color: '#a67cff' },
  { id: 'minebit', zone: 'PREFRONTAL CORTEX', title: 'MineBit', text: 'Voxel builds as NFTs on TON: Minestom, Go bridge, FunC contracts and a Telegram Web App.', color: '#65c7b5' },
  { id: 'sailfish', zone: 'BRAINSTEM', title: 'SailfishOS on ARM', text: 'A complete GNU/Linux port to Android hardware through libhybris. 2,000+ downloads and a 200-user community.', color: '#76a7ff' },
  { id: 'audio', zone: 'AUDITORY CORTEX', title: 'Zero-interference audio', text: 'PostmarketOS, custom kernels and a clean digital audio path — the physical runtime underneath the ideas.', color: '#ed8fbd' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Inside ${SITE_AUTHOR}'s mind — an interactive project atlas`} />
    <title>Inside the mind</title>
  </head>
  <body>
    <SiteNav />
    <main class="brain-page">
      <div class="brain-stage">
        <canvas id="brain-canvas" aria-label="Interactive 3D brain project atlas"></canvas>
        <div class="grain" aria-hidden="true"></div>
        <div class="hud hud-top">
          <p class="eyebrow">INSIDE THE EYE / ATLAS 01</p>
          <h1>My projects,<br /><em>distributed by anatomy.</em></h1>
          <p class="lede">A brain is not a portfolio grid. It is a map of obsessions that learned to cooperate.</p>
        </div>
        <a class="skip" href="#proof">Skip intro <span>→</span></a>
        <div class="hud hud-bottom">
          <span>drag to orbit</span><span>click a node</span><span>pulse: live vitals</span>
        </div>
        <div id="project-card" class="project-card" hidden>
          <button id="close-card" type="button" aria-label="Close project">×</button>
          <p id="card-zone" class="eyebrow"></p>
          <h2 id="card-title"></h2>
          <p id="card-text"></p>
        </div>
      </div>
      <section id="proof" class="proof">
        <div class="proof-intro"><p class="eyebrow">PROOF OF WORK</p><h2>The readable layer<br /><em>after the hallucination.</em></h2></div>
        <div class="proof-grid">
          {projects.map((project) => <article class="proof-card" style={`--accent: ${project.color}`}><span>{project.zone}</span><h3>{project.title}</h3><p>{project.text}</p></article>)}
        </div>
      </section>
    </main>
    <script type="importmap">
      { "imports": { "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js" } }
    </script>
    <script type="module" src="/brain/brain-atlas.js"></script>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; background: #06050e; }
  :global(body) { margin: 0; background: #06050e; color: #f0ebef; overflow-x: hidden; }
  :global(body > nav), :global(body > header) { position: absolute; z-index: 20; inset: 0 0 auto; }
  .brain-page { min-height: 100vh; background: #06050e; }
  .brain-stage { height: max(760px, 100svh); position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(circle at 50% 48%, #24152e 0, #0d0918 38%, #06050e 76%); }
  #brain-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; }
  #brain-canvas:active { cursor: grabbing; }
  .grain { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: .08; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E"); mix-blend-mode: screen; }
  .hud { position: absolute; z-index: 2; pointer-events: none; }
  .hud-top { left: clamp(22px, 7vw, 110px); top: clamp(100px, 16vh, 160px); max-width: 390px; }
  .eyebrow { margin: 0 0 14px; color: #d5a95b; font: 10px/1.2 var(--font-mono, monospace); letter-spacing: .15em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { font: 400 clamp(40px, 6vw, 78px)/.94 var(--font-serif, Georgia, serif); letter-spacing: -.055em; }
  em { color: #d6a6ff; font-style: italic; }
  .lede { max-width: 280px; color: #aaa1b2; font: 14px/1.5 var(--font-sans, sans-serif); }
  .skip { position: absolute; z-index: 3; top: 32px; right: clamp(22px, 7vw, 110px); color: #f0ebef; font: 11px var(--font-mono, monospace); text-decoration: none; border-bottom: 1px solid #64566b; padding-bottom: 7px; }
  .skip span { color: #d5a95b; margin-left: 8px; }
  .hud-bottom { left: clamp(22px, 7vw, 110px); right: clamp(22px, 7vw, 110px); bottom: 28px; display: flex; justify-content: space-between; color: #73697a; font: 10px var(--font-mono, monospace); text-transform: uppercase; letter-spacing: .1em; }
  .project-card { position: absolute; z-index: 5; right: clamp(22px, 7vw, 110px); bottom: 100px; width: min(300px, calc(100vw - 44px)); padding: 22px; border: 1px solid #5b3d66; background: rgba(12, 8, 22, .84); backdrop-filter: blur(16px); box-shadow: 0 12px 60px #0008; }
  .project-card h2 { font: 400 27px/1 var(--font-serif, Georgia, serif); letter-spacing: -.03em; }
  .project-card p:not(.eyebrow) { color: #b5aabd; font: 14px/1.5 var(--font-sans, sans-serif); }
  #close-card { position: absolute; top: 10px; right: 12px; border: 0; background: none; color: #b5aabd; font-size: 22px; cursor: pointer; }
  .proof { max-width: 1100px; margin: 0 auto; padding: 130px clamp(22px, 7vw, 110px) 150px; }
  .proof-intro h2 { font: 400 clamp(38px, 5vw, 66px)/.95 var(--font-serif, Georgia, serif); letter-spacing: -.05em; }
  .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 70px; background: #2a2031; border: 1px solid #2a2031; }
  .proof-card { min-height: 190px; padding: 25px; background: #0d0917; border-top: 2px solid var(--accent); }
  .proof-card span { color: var(--accent); font: 10px var(--font-mono, monospace); letter-spacing: .12em; }
  .proof-card h3 { margin: 26px 0 10px; font: 400 25px var(--font-serif, Georgia, serif); }
  .proof-card p { max-width: 390px; margin: 0; color: #9d93a7; font: 14px/1.55 var(--font-sans, sans-serif); }
  @media (max-width: 680px) { .hud-top { top: 92px; } .hud-bottom { gap: 10px; flex-wrap: wrap; } .hud-bottom span:last-child { display: none; } .proof-grid { grid-template-columns: 1fr; } .project-card { bottom: 72px; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
