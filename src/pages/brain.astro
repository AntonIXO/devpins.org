---
import { mindZones } from '../data/mind';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Inner world · Anton Ivanov</title><meta name="description" content="Six connected territories: Anton Ivanov's projects, research and obsessions."/><link rel="icon" href="/favicon.svg"/></head>
<body>
<header><a href="/" class="brand">Anton Ivanov<span> / INNER WORLD</span></a><a class="skip" href="#proof">Skip intro → Proof of work</a></header>
<main>
<section class="world" aria-label="Interactive project map">
 <div class="heading"><p class="eyebrow">A MAP OF CONNECTED OBSESSIONS</p><h1>Everything<br/>is connected.</h1><p class="intro">Biology. Machines. Perception.<br/>Six ways into the things I build.</p></div>
 <div class="viewport"><canvas id="mind-canvas" aria-label="Three-dimensional brain. Drag to rotate. Use region buttons to explore."></canvas><div id="hotspots" aria-label="Brain regions"></div><p id="scene-status" role="status">Assembling the inner world…</p></div>
 <div class="scene-tools"><span>01 — INNER WORLD</span><div><button id="rotate" type="button" aria-pressed="false">Pause motion</button><button id="reset" type="button">Reset view ↗</button></div><span class="drag-hint">DRAG TO EXPLORE</span></div>
 <aside class="territories" aria-label="Choose a territory"><p class="eyebrow">SIX TERRITORIES / SELECT TO EXPLORE</p>{mindZones.map((z,i)=><button class="zone" data-zone={i} aria-pressed={i===0} style={`--zone:${z.color}`}><span>{z.number}</span><div>{z.title}<small>{z.area}</small></div><span>↗</span></button>)}</aside>
 <article id="detail" aria-live="polite" style={`--accent:${mindZones[0].color}`}><div class="detail-meta"><span id="detail-area">01 / Corpus callosum</span><span id="detail-status">Research in progress</span></div><h2 id="detail-title">Sensor Language Models</h2><p id="detail-text">{mindZones[0].text}</p><a id="detail-link" href={mindZones[0].href}>Research ↗</a></article>
 <p class="footnote">An anatomical metaphor. A connected body of work.<span>Surface: fsaverage5 · <a href="/mind/LICENSE.txt">credits & license</a></span></p>
</section>
<section id="proof" tabindex="-1"><p class="eyebrow">PROOF OF WORK / THE READABLE LAYER</p><h2>Ideas, made tangible.</h2><div class="proof-grid">{mindZones.map(z=><article style={`--accent:${z.color}`}><p class="eyebrow">{z.number} / {z.area}</p><h3>{z.project}</h3><p>{z.built}</p><a href={z.href}>{z.action} ↗</a></article>)}</div><a class="back" href="/cv/">Full CV →</a></section>
</main>
<script>import '../scripts/mind';</script>
</body></html>
<style>
:global(*){box-sizing:border-box} :global(html){background:#080d10;color:#e6e7df;scroll-behavior:smooth} :global(body){margin:0;font-family:Arial,sans-serif} :global(a){color:inherit;text-decoration:none} :global(button){font:inherit;cursor:pointer} :global(a:focus-visible),:global(button:focus-visible){outline:2px solid #f4c580;outline-offset:5px} header{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff13;padding:0 4vw;font-size:13px}.brand{font-size:16px}.brand span{font:10px monospace;color:#8d9999;letter-spacing:.12em}.skip{font:11px monospace;color:#d6dfd7}.world{position:relative;min-height:860px;height:calc(100svh - 82px);max-height:1100px;overflow:hidden;background:radial-gradient(ellipse at 57% 41%,#15262980,transparent 57%)}.heading{position:absolute;top:53px;left:4vw;pointer-events:none;z-index:2}.eyebrow{font:10px/1.6 monospace;letter-spacing:.15em;color:#96aaa7}h1{font:400 clamp(42px,4.5vw,76px)/.98 Georgia,serif;letter-spacing:-.05em;margin:25px 0 22px}.intro{font-size:13px;line-height:1.75;color:#8a9b9c}.viewport{position:absolute;left:24%;right:0;top:0;bottom:195px}canvas{display:block;width:100%;height:100%;touch-action:pan-y}#hotspots{position:absolute;inset:0;pointer-events:none}#hotspots :global(button){position:absolute;width:32px;height:32px;border:1px solid var(--zone);border-radius:50%;background:#0b151be0;color:var(--zone);font:11px monospace;pointer-events:auto;box-shadow:0 0 24px #76b3a522}#hotspots :global(button[aria-pressed=true]){background:var(--zone);color:#081014;box-shadow:0 0 24px var(--zone)}#scene-status{position:absolute;bottom:30px;left:20%;font:11px monospace;color:#8fa4a0}.territories{position:absolute;left:4vw;top:340px;width:260px;z-index:3}.zone{display:flex;align-items:center;gap:14px;width:100%;border:0;border-top:1px solid #ffffff12;background:transparent;color:#9baba9;text-align:left;padding:13px 0;font-size:12px}.zone>span{font:10px monospace;color:var(--zone)}.zone>span:last-child{margin-left:auto}.zone small{display:block;font:9px monospace;color:#6e8385;margin-top:6px}.zone[aria-pressed=true]{color:#eff3e7}.zone[aria-pressed=true] div{color:var(--zone)}#detail{position:absolute;left:36%;right:5%;bottom:65px;padding:24px 0 0;border-top:1px solid var(--accent);z-index:3}.detail-meta{display:flex;justify-content:space-between;gap:10px;font:9px monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}#detail h2{font:400 29px Georgia,serif;margin:18px 0 10px}#detail p{color:#92a5a5;font-size:13px;line-height:1.7;max-width:570px;margin-bottom:16px}#detail a{font:11px monospace;color:var(--accent)}.scene-tools{position:absolute;top:24px;left:36%;right:4vw;display:flex;justify-content:space-between;align-items:center;color:#78908e;font:9px monospace;letter-spacing:.1em;z-index:4}.scene-tools button{background:none;border:0;color:#a3b6b3;font:10px monospace;padding:10px}.footnote{position:absolute;bottom:14px;left:4vw;right:4vw;font:9px monospace;color:#6c8283;display:flex;justify-content:space-between}#proof{max-width:1180px;margin:auto;padding:100px 4vw}#proof>h2{font:400 clamp(36px,5vw,60px) Georgia,serif;letter-spacing:-.04em}.proof-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:50px 65px;margin:60px 0}.proof-grid article{border-top:1px solid #ffffff23;padding-top:20px}.proof-grid h3{font:400 25px Georgia,serif}.proof-grid p:not(.eyebrow){font-size:14px;color:#95a5a4;line-height:1.8}.proof-grid a,.back{color:var(--accent,#e1c58c);font:12px monospace}
@media(min-width:1500px){.territories{width:300px}.viewport{left:20%}}@media(max-width:900px){.world{height:auto;max-height:none;min-height:0;padding-bottom:70px}.heading{top:30px}h1{font-size:45px}.intro{font-size:12px}.viewport{position:relative;left:0;right:auto;top:auto;bottom:auto;width:100%;height:630px}.heading{z-index:2}.scene-tools{top:560px;left:4vw}.territories{position:relative;top:auto;left:auto;margin:0 4vw;width:auto;display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.territories>.eyebrow{grid-column:1/-1}#detail{position:relative;left:auto;right:auto;bottom:auto;margin:30px 4vw 20px}.footnote{flex-direction:column;gap:8px}.drag-hint{display:none}.proof-grid{gap:30px}.brand span{display:none}}@media(max-width:500px){header{height:66px}.skip{font-size:9px}.viewport{height:550px}.heading{top:20px}h1{font-size:38px}.heading .intro{display:none}.scene-tools{top:492px}.zone{font-size:11px;gap:8px}.zone small{font-size:8px}.proof-grid{grid-template-columns:1fr}.detail-meta{font-size:8px}.footnote{font-size:8px}}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
