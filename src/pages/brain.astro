---
import { mindZones } from '../data/mind';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Inner world · Anton Ivanov</title><meta name="description" content="Six connected territories: Anton Ivanov's projects, research and obsessions."/><link rel="icon" href="/favicon.svg"/></head>
<body>
<header><a href="/" class="brand">Anton Ivanov<span> / INNER WORLD</span></a><a class="skip" href="#proof">Projects ↗</a></header>
<main>
<section class="world" aria-label="Interactive project map">
 <div class="viewport"><canvas id="mind-canvas" aria-label="Three-dimensional brain. Drag to rotate. Use region buttons to explore."></canvas><div id="hotspots" aria-label="Brain regions"></div><p id="scene-status" role="status">Assembling the inner world…</p></div>
 <div class="scene-tools"><button id="rotate" type="button" aria-pressed="false">Pause</button><button id="reset" type="button">Reset ↗</button></div>
 <div class="health"><p id="health-values">Reading vitals…</p><p id="health-source">Fallback</p><svg viewBox="0 0 320 40" role="img" aria-label="Synthetic EEG-style wave driven by HR, HRV and sleep; not measured EEG"><path id="eeg-trace" d="M0 20H320"/></svg><span>EEG-STYLE / SYNTHETIC</span></div>
 <aside class="territories" aria-label="Choose a project">{mindZones.map((z,i)=><button class="zone" data-zone={i} aria-pressed="false" style={`--zone:${z.color}`}><span>{z.number}</span><span>{z.project}</span></button>)}</aside>
 <article id="detail" hidden aria-live="polite" style={`--accent:${mindZones[0].color}`}><button id="close-detail" aria-label="Close project">×</button><div class="detail-meta"><span id="detail-area">01 / Corpus callosum</span><span id="detail-status">Research in progress</span></div><h2 id="detail-title">Sensor Language Models</h2><a id="detail-link" href={mindZones[0].href}>Research ↗</a></article>
 <p class="footnote">Drag to explore<span><a href="/mind/LICENSE.txt">Surface credits</a></span></p>
</section>
<section id="proof" tabindex="-1"><p class="eyebrow">PROJECTS</p><h2>Selected work.</h2><div class="proof-grid">{mindZones.map(z=><article style={`--accent:${z.color}`}><p class="eyebrow">{z.number} / {z.area}</p><h3>{z.project}</h3><p>{z.built}</p><a href={z.href}>{z.action} ↗</a></article>)}</div><a class="back" href="/cv/">Full CV →</a></section>
</main>
<script>import '../scripts/mind';</script>
</body></html>
<style>
:global(*){box-sizing:border-box} :global(html){background:#09050f;color:#eee4d9;scroll-behavior:smooth} :global(body){margin:0;font-family:Arial,sans-serif} :global(a){color:inherit;text-decoration:none} :global(button){font:inherit;cursor:pointer} :global([hidden]){display:none!important} :global(a:focus-visible),:global(button:focus-visible){outline:2px solid #f4c580;outline-offset:5px}
header{position:absolute;inset:0 0 auto;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:26px 32px;pointer-events:none}header a{pointer-events:auto}.brand{font-size:14px}.brand span{font:9px monospace;color:#a48a9c;letter-spacing:.14em}.skip{font:11px monospace;color:#ead6be}.world{position:relative;height:100svh;min-height:540px;overflow:hidden}.viewport{position:absolute;inset:0}canvas{display:block;width:100%;height:100%;touch-action:pan-y}#hotspots{position:absolute;inset:0;pointer-events:none}#hotspots :global(button){position:absolute;width:40px;height:40px;border:1px solid #e9b98560;border-radius:50%;background:#170b22b3;color:#ead8bc;font:11px monospace;pointer-events:auto;box-shadow:0 0 24px #d8965720;backdrop-filter:blur(6px)}#hotspots :global(button[aria-pressed=true]){background:#e9c18b;color:#180a20;box-shadow:0 0 30px #e4a25170}#scene-status{position:absolute;top:45%;width:100%;text-align:center;font:11px monospace;color:#b99cae}.scene-tools{position:absolute;right:25px;top:75px;z-index:4;display:flex;gap:8px}.scene-tools button{background:#160c2080;border:1px solid #dec9e01c;border-radius:20px;padding:9px 13px;color:#bba8b9;font:10px monospace}.health{position:absolute;top:90px;left:32px;width:260px;pointer-events:none}.health p{margin:0 0 8px;font:11px monospace;color:#d3b69a}#health-source{font-size:9px;color:#9b7e99}.health svg{width:100%;height:40px;overflow:visible;margin-top:12px}.health path{stroke:#d5a970;fill:none;stroke-width:1;opacity:.75}.health>span{font:7px monospace;letter-spacing:.15em;color:#8c7389}.territories{position:absolute;z-index:3;left:32px;right:32px;bottom:55px;display:flex;justify-content:center;gap:6px;flex-wrap:wrap}.zone{display:flex;align-items:center;gap:9px;border:1px solid #c99fbb29;border-radius:24px;background:#170b20b3;backdrop-filter:blur(14px);color:#c6afbf;padding:12px 16px;font-size:11px}.zone>span:first-child{font:9px monospace;color:#bd956a}.zone[aria-pressed=true]{border-color:#e4bd89;color:#f6debb;background:#44233cbb}#detail{position:absolute;right:32px;bottom:120px;width:310px;padding:24px;background:#130a1ae6;backdrop-filter:blur(22px);border:1px solid #d4a7c532;border-radius:16px;z-index:4}.detail-meta{display:flex;flex-direction:column;gap:7px;font:8px monospace;letter-spacing:.08em;text-transform:uppercase;color:#c397a9}#detail h2{font:400 25px Georgia,serif;margin:18px 0}#detail a{font:11px monospace;color:#e9bf83}#close-detail{position:absolute;right:8px;top:8px;background:none;border:0;font-size:22px;color:#a2899e;padding:5px 9px}.footnote{position:absolute;bottom:15px;left:32px;right:32px;display:flex;justify-content:space-between;font:8px monospace;text-transform:uppercase;letter-spacing:.12em;color:#846e81;pointer-events:none}.footnote a{pointer-events:auto}.eyebrow{font:10px/1.6 monospace;letter-spacing:.15em;color:#b39ca8}#proof{max-width:1180px;margin:auto;padding:80px 32px}#proof>h2{font:400 clamp(36px,5vw,60px) Georgia,serif;letter-spacing:-.04em}.proof-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:50px 65px;margin:60px 0}.proof-grid article{border-top:1px solid #ffffff23;padding-top:20px}.proof-grid h3{font:400 25px Georgia,serif}.proof-grid p:not(.eyebrow){font-size:14px;color:#b29caa;line-height:1.8}.proof-grid a,.back{color:#e1c58c;font:12px monospace}
@media(max-width:650px){header{padding:20px}.brand span{display:none}.health{top:74px;left:20px;width:205px}.health p{font-size:10px}.scene-tools{right:16px;top:70px;flex-direction:column}.territories{left:12px;right:12px;bottom:42px;gap:5px}.zone{font-size:9px;padding:10px 12px;gap:6px}.zone>span:first-child{font-size:8px}.footnote{left:20px;right:20px;font-size:7px}#detail{left:20px;right:20px;bottom:170px;width:auto}.proof-grid{grid-template-columns:1fr}.health svg{height:28px;margin-top:6px}.world{min-height:620px}}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
