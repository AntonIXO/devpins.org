---
import SectionLabel from '../../components/SectionLabel.astro';
import WritingLanguageSwitch from '../../components/WritingLanguageSwitch.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../data/nav';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = await getPublishedPosts();
---

<SiteLayout title="Writing" description={`Notes from ${SITE_TITLE}.`} wide={false} atmosphere="blank">
	<section class="writing">
		<SectionLabel>Writing</SectionLabel>
		{posts.length === 0 ? <p class="empty">No posts yet.</p> : <WritingLanguageSwitch posts={posts} />}
	</section>
</SiteLayout>

<style>
	.writing {
		padding-top: 48px;
		padding-bottom: 48px;
	}

	.rows {
		list-style: none;
		display: flex;
		flex-direction: column;
	}

	.rows a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		padding: 14px 0;
		border-top: 1px solid var(--rule);
		color: var(--ink);
	}

	.rows li:last-child a {
		border-bottom: 1px solid var(--rule);
	}

	.title {
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	.rows a:hover .title {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.date,
	.empty {
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
		flex: none;
	}

	@media (max-width: 720px) {
		.rows a {
			flex-direction: column;
			gap: 6px;
		}
	}
</style>
