---
import SectionLabel from '../components/SectionLabel.astro';
import { SITE_AUTHOR, SITE_LOCATION } from '../consts';
import { awards, cvLinks, cvProjects, education, skills } from '../data/cv';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
	title="Curriculum vitae"
	description={`CV — ${SITE_AUTHOR}`}
	type="profile"
	wide={false}
	atmosphere="blank"
>
	<article class="cv">
		<h1>{SITE_AUTHOR}</h1>
		<p class="place">{SITE_LOCATION}</p>
		<div class="chips">
			{
				cvLinks.map((link) => (
					<a
						href={link.href}
						target={link.href.startsWith('mailto:') ? undefined : '_blank'}
						rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
					>
						{link.label}
					</a>
				))
			}
		</div>

		<SectionLabel>Education</SectionLabel>
		<div class="stack">
			{
				education.map((item) => (
					<div class:list={['card', { compact: !item.bullets }]}>
						<div class="card__head">
							<h2>{item.title}</h2>
							<span>{item.period}</span>
						</div>
						{item.meta &&
							(item.metaHref ? (
								<p class="meta">
									<a href={item.metaHref} target="_blank" rel="noopener noreferrer">
										{item.meta.split(' · ')[0]}
									</a>
									{' · '}
									{item.meta.split(' · ').slice(1).join(' · ')}
								</p>
							) : (
								<p class="meta">{item.meta}</p>
							))}
						{item.bullets && (
							<ul>
								{item.bullets.map((bullet) => (
									<li>{bullet}</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</div>

		<SectionLabel>Projects</SectionLabel>
		<div class="stack">
			{
				cvProjects.map((item) => (
					<div class="card">
						<div class="card__head">
							<h2>
								{item.href ? (
									<a href={item.href} target="_blank" rel="noopener noreferrer">
										{item.title}
									</a>
								) : (
									item.title
								)}
							</h2>
							<span>{item.period}</span>
						</div>
						<p class="lede">{item.lede}</p>
						<ul>
							{item.bullets.map((bullet) => (
								<li
									set:html={bullet.replace(
										'Yuri Rykov (scholar profile)',
										'<a href="https://scholar.google.com/citations?user=hOxcaCcAAAAJ&hl=ru" target="_blank" rel="noopener noreferrer">Yuri Rykov</a>',
									)}
								/>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<SectionLabel>Awards</SectionLabel>
		<div class="awards">
			{
				awards.map((item) => (
					<div class="award">
						<span>{item.mark}</span>
						<p>
							{item.text}
							{item.note && <em> — {item.note}</em>}
						</p>
					</div>
				))
			}
		</div>

		<SectionLabel>Skills</SectionLabel>
		<div class="skills">
			{
				skills.map((group) => (
					<div class="skill">
						<p>{group.label}</p>
						<div>
							{group.items.map((item) => (
								<span>{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</article>
</SiteLayout>

<style>
	.cv {
		padding: 72px 0 24px;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.place {
		margin-top: 10px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin-top: 20px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
	}

	.chips a:hover {
		color: var(--ink);
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.card.compact {
		display: flex;
		align-items: baseline;
		gap: 16px;
	}

	.card__head {
		display: flex;
		align-items: baseline;
		gap: 16px;
		flex-wrap: wrap;
	}

	.card h2 {
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.015em;
		flex: 1;
		min-width: 240px;
	}

	.card.compact h2 {
		font-size: 16px;
	}

	.card h2 a {
		border-bottom: 1px solid var(--rule);
	}

	.card h2 a:hover {
		border-bottom-color: var(--ink);
	}

	.card span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--mute);
	}

	.meta {
		font-size: 14px;
		color: var(--mute);
		margin-top: 8px;
	}

	.meta a {
		border-bottom: 1px solid var(--rule);
	}

	.lede {
		font-size: 15px;
		line-height: 1.6;
		margin-top: 10px;
	}

	ul {
		margin: 14px 0 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 7px;
		font-size: 14.5px;
		line-height: 1.55;
		color: color-mix(in srgb, var(--ink) 78%, var(--paper));
	}

	ul :global(a) {
		border-bottom: 1px solid var(--rule);
	}

	.awards {
		display: flex;
		flex-direction: column;
	}

	.award {
		display: flex;
		align-items: baseline;
		gap: 20px;
		padding: 14px 0;
		border-top: 1px solid var(--rule);
	}

	.award:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.award span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--mute);
		width: 104px;
		flex: none;
	}

	.award p {
		font-size: 15.5px;
		line-height: 1.55;
		flex: 1;
	}

	.award em {
		font-style: normal;
		color: var(--mute);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.skill {
		display: flex;
		align-items: baseline;
		gap: 20px;
		flex-wrap: wrap;
	}

	.skill p {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--mute);
		width: 108px;
		flex: none;
	}

	.skill div {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
		flex: 1;
		font-size: 14.5px;
	}

	@media (max-width: 720px) {
		.cv {
			padding-top: 48px;
		}

		.award {
			flex-direction: column;
			gap: 6px;
		}
	}

	@media print {
		.cv {
			padding-top: 0;
		}
	}
</style>
