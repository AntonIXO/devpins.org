---
import CvPortrait from '../components/CvPortrait.astro';
import SectionLabel from '../components/SectionLabel.astro';
import VibesciencePreview from '../components/VibesciencePreview.astro';
import { SITE_AUTHOR, SITE_LOCATION } from '../consts';
import { awards, cvLinks, cvProjects, cvProjectsNote, education, miscVibeProjects, skills } from '../data/cv';
import vibescienceGraph from '../data/vibescience-graph.json';
import SiteLayout from '../layouts/SiteLayout.astro';

const previewNodes = [...vibescienceGraph.nodes]
	.sort((a, b) => b.degree - a.degree)
	.slice(0, 120)
	.map((node) => ({
		id: node.id,
		label: node.label,
		degree: node.degree,
		val: node.size,
		color:
			node.kind === 'diagnostics'
				? '#c28b5a'
				: node.kind === 'experiments'
					? '#c4a15b'
					: node.kind === 'hypotheses'
						? '#8f83c1'
						: node.kind === 'problems'
							? '#c46c6c'
							: node.kind === 'papers'
								? '#6e9eae'
								: '#8b8e97',
		x: node.x,
		y: node.y,
	}));
const previewNodeIds = new Set(previewNodes.map((node) => node.id));
const previewLinks = vibescienceGraph.edges
	.filter((edge) => previewNodeIds.has(edge.source) && previewNodeIds.has(edge.target))
	.map((edge) => ({ source: edge.source, target: edge.target, weight: edge.weight }));
const vibesciencePreviewData = JSON.stringify({ nodes: previewNodes, links: previewLinks }).replace(/</g, '\\u003c');
---

<SiteLayout
	title="Anton Ivanov — Software Engineering CV & Projects"
	description="Explore Anton Ivanov’s CV: education at ITMO, software engineering experience, and projects in personal health analytics, AI, and mobile Linux."
	type="profile"
	wide={false}
	atmosphere="blank"
>
	<article class="cv">
		<div class="cv-intro" data-cv-intro>
			<header class="cv-header">
				<div class="portrait-rail">
					<div class="portrait-sticky"><CvPortrait /></div>
				</div>
				<div class="cv-identity">
					<h1>{SITE_AUTHOR}</h1>
					<p class="place">{SITE_LOCATION}</p>
					<div class="chips">
						{
							cvLinks.map((link) => (
								<a
									href={link.href}
									target={link.href.startsWith('mailto:') ? undefined : '_blank'}
									rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
									data-umami-event="cv-contact-click"
									data-umami-event-channel={link.label.toLowerCase()}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</div>
			</header>

			<SectionLabel>Education</SectionLabel>
			<div class="stack">
				{
					education.map((item) => (
						<div class:list={['card', { compact: !item.bullets }]}>
							<div class="card__head">
								<h2>
									{item.institution && <>
										<a class="education-institution" href={item.institution.href} target="_blank" rel="noopener noreferrer"
											data-umami-event="cv-education-click" data-umami-event-institution={`${item.institution.logoAlt} ${item.institution.suffix}`}>
											<img class="education-logo" src={item.institution.logo.src} width={item.institution.logo.width}
												height={item.institution.logo.height} alt={item.institution.logoAlt} />{' '}
											{item.institution.suffix}
										</a>{' — '}
									</>}
									{item.title}
								</h2>
								<span>{item.period}</span>
							</div>
							{item.meta &&
								(item.metaHref ? (
									<p class="meta">
										<a
											href={item.metaHref}
											target="_blank"
											rel="noopener noreferrer"
											data-umami-event="cv-education-click"
											data-umami-event-institution={item.meta.split(' · ')[0]}
										>
											{item.meta.split(' · ')[0]}
										</a>
										{' · '}
										{item.meta.split(' · ').slice(1).join(' · ')}
									</p>
								) : (
									<p class="meta">{item.meta}</p>
								))}
							{item.bullets && (
								<ul>
									{item.bullets.map((bullet) => (
										<li class="cv-bullet">{bullet}</li>
									))}
								</ul>
							)}
						</div>
					))
				}
			</div>
		</div>

		{[
			{ id: 'main', title: 'Projects', items: cvProjects, event: 'cv-project-click', note: cvProjectsNote },
			{ id: 'misc', title: 'Misc vibe', items: miscVibeProjects, event: 'cv-misc-project-click' },
		].map(section => (
			<Fragment>
				<SectionLabel>{section.title}</SectionLabel>
				{section.note && <p class="section-note">{section.note}</p>}
				<div class:list={['projects', { 'misc-vibe': section.id === 'misc' }]}>
					{section.items.map((item, index) => {
						const hasMedia = Boolean(item.image || item.screenshots?.length || item.preview || item.video || item.videoEmbed || item.diagram);
						const hasInsights = Boolean(item.insights?.length);
						const expandable = Boolean(item.bullets?.length || hasInsights || hasMedia);
						const Row = expandable ? 'details' : 'article';
						const Header = expandable ? 'summary' : 'div';
						const panelId = `project-panel-${section.id}-${index}`;
						return (
							<Row class="project" data-cv-project={expandable ? "" : undefined}>
								<Header class="project__summary" aria-controls={expandable ? panelId : undefined}>
									<span class="project__title"><a href={item.href} target={item.href?.startsWith('/') ? undefined : '_blank'}
										rel="noopener noreferrer" data-umami-event={section.event} data-umami-event-project={item.title}>
										{item.title}
									</a></span>
									{item.period && <span class="project__period">{item.period}</span>}
									<span class="project__lede" set:html={item.lede} />
									{expandable && <span class="project__indicator" aria-hidden="true"></span>}
								</Header>
								{expandable && <div class:list={["project__panel", { "project__panel--text": !hasMedia && !hasInsights }]} id={panelId}>
									{item.bullets?.length ? <ul>{item.bullets.map(bullet => <li class="cv-bullet" set:html={bullet} />)}</ul> : null}
									{hasInsights && <aside class="project__insights" aria-labelledby={`${panelId}-insights`}>
										<h3 id={`${panelId}-insights`}>Some interesting insights</h3>
										<ul>
											{item.insights?.map(({ label, href, note, trackingId }) => (
												<li>
													<a href={href} target="_blank" rel="noopener noreferrer"
														data-umami-event={trackingId ? 'cv-insight-click' : undefined} data-umami-event-insight={trackingId}>{label}</a>
													{note && <small>{note}</small>}
												</li>
											))}
										</ul>
									</aside>}
									{hasMedia && <div class:list={['project__media', {
											'project__media--screenshots': item.screenshots?.length,
											'project__media--with-note': item.video?.note,
										}]}
										style={item.screenshots?.length ? {
											gridTemplateColumns: item.screenshots.map(({ width, height }) => `minmax(0, ${width / height}fr)`).join(' '),
										} : undefined}>
										{(item.screenshots ?? (item.image ? [item.image] : [])).map(media => {
											const href = 'href' in media ? media.href : undefined;
											return (
												<a class="project__zoom" href={media.src} data-cv-zoom data-image-link={href}
													aria-label={`Enlarge image: ${media.alt}`}>
													<img loading="lazy" src={media.src} alt={media.alt}
														width={'width' in media ? media.width : undefined}
														height={'height' in media ? media.height : undefined} />
												</a>
											);
										})}
										{item.preview && <VibesciencePreview data={vibesciencePreviewData} />}
										{item.video && <video controls playsinline preload="none" poster={item.video.poster} aria-label={item.video.label}>
											{item.video.webm && <source src={item.video.webm} type="video/webm" />}
											<source src={item.video.src} type="video/mp4" />
											{item.video.captions?.map(caption => (
												<track
													kind={caption.kind}
													src={caption.src}
													srclang={caption.lang}
													label={caption.label}
													default={caption.default}
												/>
											))}
										</video>}
										{item.video?.note && <small class="project__video-note">{item.video.note}</small>}
										{item.videoEmbed && <iframe
											src={item.videoEmbed}
											title={`${item.title} video`}
											loading="lazy"
											referrerpolicy="strict-origin-when-cross-origin"
											allow="fullscreen; picture-in-picture"
										></iframe>}
										{item.diagram && <ol class="project__diagram">{item.diagram.map(step => <li>{step}</li>)}</ol>}
									</div>}
								</div>}
							</Row>
						);
					})}
				</div>
			</Fragment>
		))}

		<div class="cv-outro" data-cv-outro>
			<div>
				<SectionLabel>Awards</SectionLabel>
				<div class="awards">
					{
						awards.map((item) => (
							<div class="award">
								<span>{item.mark}</span>
								<p>
								{item.parts.map((part) => {
									if (typeof part === 'string') return part;
									const image = part.diploma && `/diplomas/${part.diploma}.webp`;
									if (part.href) {
										return <a href={part.href} target="_blank" rel="noopener noreferrer" data-cv-diploma={image}>{part.label}</a>;
									}
									if (image) {
										return <a href={image} data-cv-diploma={image} data-cv-zoom
											data-cv-image-alt={`Published results: ${part.label}`}>{part.label}</a>;
									}
									return part.label;
								})}
									{item.note && <em> — {item.note}</em>}
								</p>
							</div>
						))
					}
				</div>

				<SectionLabel>Skills</SectionLabel>
				<div class="skills">
					{
						skills.map((group) => (
							<div class="skill">
								<p>{group.label}</p>
								<div>
									{group.items.map((item) => (
										<span>{item}</span>
									))}
								</div>
							</div>
						))
					}
				</div>
			</div>
			<div class="pointing-portrait">
				<div class="pointing-track"><CvPortrait variant="pointing" /></div>
			</div>
		</div>
		<div class="cv-diploma-preview" data-cv-diploma-preview popover="manual" aria-hidden="true">
			<img alt="" />
		</div>
		<dialog class="cv-image-viewer" data-cv-image-viewer aria-label="Image preview">
			<div class="cv-image-viewer__content">
				<form method="dialog">
					<button autofocus aria-label="Close image"><span aria-hidden="true">×</span></button>
				</form>
				<img alt="" />
				<a data-cv-image-link hidden>Explore the live graph</a>
			</div>
		</dialog>
	</article>
</SiteLayout>

<script>
	import '../scripts/cv-portrait';
	import '../scripts/cv-projects';
	import '../scripts/cv-diplomas';
</script>

<style>
	.cv {
		--cv-top: 72px;
		--portrait-rail-gap: 34px;
		--portrait-gutter-width: calc((100vw - var(--page-max-narrow)) / 2 - var(--portrait-rail-gap) - var(--page-pad-x));
		position: relative;
		padding: var(--cv-top) 0 24px;
	}

	.cv-header {
		display: grid;
		grid-template-columns: clamp(88px, 24vw, 158px) minmax(0, 1fr);
		align-items: center;
		gap: clamp(15px, 3vw, 30px);
	}

	@media screen and (min-width: 1120px) and (min-height: 450px) {
		.cv-header {
			display: block;
		}

		.portrait-rail {
			position: absolute;
			inset-block: var(--cv-top) 24px;
			right: calc(100% + var(--portrait-rail-gap));
			width: clamp(136px, var(--portrait-gutter-width), 238px);
		}

		.portrait-sticky {
			position: sticky;
			top: 28px;
		}

		.portrait-sticky > :global([data-cv-portrait='rail']) {
			--portrait-position: 54% 45%;
			height: var(--portrait-height, auto);
		}
	}

	.section-note {
		margin: 0 0 24px;
		font-size: 13px;
		color: var(--mute);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.place {
		margin-top: 10px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin-top: 20px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
	}

	.chips a:hover {
		color: var(--ink);
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.card.compact {
		display: flex;
		align-items: baseline;
		gap: 16px;
	}

	.education-institution {
		white-space: nowrap;
	}

	.education-logo {
		display: inline-block;
		width: auto;
		height: 1.2792em;
		vertical-align: baseline;
	}

	@media screen {
		:global(html[data-theme='dark']) .education-logo {
			filter: brightness(0) invert(1);
		}
	}

	@media screen and (prefers-color-scheme: dark) {
		:global(html:not([data-theme])) .education-logo {
			filter: brightness(0) invert(1);
		}
	}

	.card__head {
		display: flex;
		align-items: baseline;
		gap: 16px;
		flex-wrap: wrap;
	}

	.card h2 {
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.015em;
		flex: 1;
		min-width: 240px;
	}

	.card.compact h2 {
		font-size: 16px;
	}

	.card h2 a {
		border-bottom: 1px solid var(--rule);
	}

	.card h2 a:hover {
		border-bottom-color: var(--ink);
	}

	.card span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--mute);
	}

	.meta {
		font-size: 14px;
		color: var(--mute);
		margin-top: 8px;
	}

	.meta a {
		border-bottom: 1px solid var(--rule);
	}

	.lede {
		font-size: 15px;
		line-height: 1.6;
		margin-top: 10px;
	}

	.projects {
		container-type: inline-size;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 10px;
	}
	.projects.misc-vibe { gap: 4px; }
	.misc-vibe .project__summary { padding-block: 9px; }
	.project {
		--expanded-width: max(100cqw, calc(50cqw + 50vw - var(--page-pad-x)));
		box-sizing: border-box;
		width: 100%;
		border-top: 1px solid var(--rule);
		overflow: clip;
		overflow-anchor: none;
	}
	.project[open] {
		width: var(--expanded-width);
	}
	.project__summary {
		box-sizing: border-box;
		width: 100%;
		display: grid;
		/* Give the space revealed by the card to the gap before the date. */
		--date-gap: max(14px, calc(14px + 100% - 100cqw));
		grid-template-columns: minmax(0, 1fr) var(--date-gap) auto 14px 18px;
		grid-template-areas: 'title . period . indicator' 'lede lede lede . indicator';
		align-items: baseline;
		row-gap: 5px;
		padding: 14px 0;
		list-style: none;
	}
	summary.project__summary { cursor: pointer; }
	.project__summary::-webkit-details-marker { display: none; }
	.project__title { grid-area: title; font-size: 17px; font-weight: 500; line-height: 1.35; letter-spacing: -.015em; }
	.project__summary:focus-visible { outline-offset: -2px; }
	.project__title a, .project__panel :global(a) {
		color: var(--ink);
		border: 0;
		text-decoration: underline;
		text-decoration-color: var(--mute);
		text-decoration-thickness: 1px;
		text-underline-offset: .2em;
	}
	.project__title a:hover, .project__panel :global(a:hover) { text-decoration-color: var(--ink); }
	.project__lede :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
	.project__period { grid-area: period; font: 11.5px var(--font-mono); color: var(--mute); }
	.project__lede {
		grid-area: lede;
		max-width: calc(100cqw - 32px);
		font-size: 14px;
		line-height: 1.5;
		color: var(--mute);
	}
	.project__lede, .cv-bullet { white-space: pre-line; }
	.project__indicator { grid-area: indicator; text-align: center; color: var(--mute); line-height: 1; }
	.project__indicator::before { content: '+'; }
	.project[open] .project__indicator::before { content: '−'; }
	.project__panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, .9fr);
		align-items: start;
		gap: clamp(16px, 2vw, 32px);
		width: var(--expanded-width);
		padding: 16px 0;
		background: color-mix(in srgb, var(--paper) 90%, transparent);
		backdrop-filter: blur(8px);
		border-top: 1px solid var(--rule);
	}
	.project__panel--text { grid-template-columns: minmax(0, 1fr); }
	.project__panel ul { margin: 0; }
	.project__insights {
		padding: 14px 16px;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--paper);
	}
	.project__insights h3 { margin-bottom: 10px; font-size: 15px; }
	.project__insights small { display: block; color: var(--mute); font-size: 12.5px; }
	.project__media:only-child { grid-column: -2; }
	.project__media {
		position: relative;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: 8px;
		border: 1px solid var(--rule);
		background: var(--paper);
		aspect-ratio: 1.6;
	}
	.project__media img, .project__media video { width: 100%; height: 100%; object-fit: contain; min-height: 0; }
	.project__media--with-note { aspect-ratio: auto; }
	.project__media--with-note video { height: auto; aspect-ratio: 1.6; }
	.project__video-note {
		padding: 6px 10px;
		color: var(--mute);
		font-size: 11px;
	}
	.project__media--screenshots {
		gap: clamp(4px, 1vw, 10px);
		aspect-ratio: auto;
		border: 0;
		background: transparent;
	}
	.project__media--screenshots img {
		display: block;
		box-sizing: border-box;
		height: auto;
		border: 1px solid var(--rule);
		border-radius: 6px;
	}
	.project__zoom { display: block; width: 100%; cursor: zoom-in; }
	.project__media:not(.project__media--screenshots) .project__zoom { position: absolute; inset: 0; }
	.project__zoom img { display: block; }
	.project__zoom:focus-visible { outline: 2px solid var(--ink); outline-offset: -3px; }

	:global(html:has(.cv-image-viewer[open])) { overflow: hidden; }
	.cv-image-viewer {
		max-width: calc(100vw - 24px);
		max-height: calc(100dvh - 24px);
		box-sizing: border-box;
		padding: 8px;
		border: 1px solid var(--rule);
		border-radius: 12px;
		background: var(--paper);
		color: var(--ink);
	}
	.cv-image-viewer::backdrop { background: rgb(0 0 0 / 78%); }
	.cv-image-viewer__content { display: grid; justify-items: end; gap: 8px; }
	.cv-image-viewer img {
		display: block;
		max-width: 100%;
		max-height: calc(100dvh - 96px);
		object-fit: contain;
		border-radius: 5px;
		cursor: zoom-out;
	}
	.cv-image-viewer:has([data-cv-image-link]:not([hidden])) img { max-height: calc(100dvh - 128px); }
	.cv-image-viewer button {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--paper);
		color: var(--ink);
		font: 26px/1 system-ui;
		cursor: pointer;
	}
	.cv-image-viewer button:hover { border-color: var(--ink); }
	.project__media iframe { width: 100%; height: 100%; min-height: 0; border: 0; }
	.project__media :global(.vibescience-preview) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 1; visibility: visible; transform: none; border: 0; border-radius: 0; pointer-events: auto; }
	.project__media :global(.vibescience-preview:focus-visible) { outline: 2px solid var(--ink); outline-offset: -3px; }
	.project__diagram { margin: 0; padding: 10px; list-style: none; text-align: center; font: clamp(11px, 1vw, 14px) var(--font-mono); }
	.project__diagram li { width: fit-content; margin: auto; padding: 4px 14px; border: 1px solid var(--rule); border-radius: 5px; }
	.project__diagram li + li { margin-top: 12px; position: relative; }
	.project__diagram li + li::before { content: ''; position: absolute; bottom: 100%; left: 50%; height: 13px; width: 1px; background: var(--mute); }
	@media (max-width: 680px) {
		.project__panel { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 560px) {
		.project__summary {
			grid-template-columns: minmax(0, 1fr) 18px;
			grid-template-areas: 'title indicator' 'period indicator' 'lede lede';
			column-gap: 14px;
		}
		.project__summary:not(:has(.project__period)) { grid-template-areas: 'title indicator' 'lede lede'; }
		.project__lede { max-width: none; }
	}

	ul {
		margin: 14px 0 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 7px;
		font-size: 14.5px;
		line-height: 1.55;
		color: color-mix(in srgb, var(--ink) 78%, var(--paper));
	}

	ul :global(a) {
		border-bottom: 1px solid var(--rule);
	}

	.awards {
		display: flex;
		flex-direction: column;
	}

