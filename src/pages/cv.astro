---
import CvPortrait from '../components/CvPortrait.astro';
import SectionLabel from '../components/SectionLabel.astro';
import VibesciencePreview from '../components/VibesciencePreview.astro';
import { SITE_AUTHOR, SITE_LOCATION } from '../consts';
import { awards, cvLinks, cvProjects, cvProjectsNote, education, miscVibeProjects, skills } from '../data/cv';
import vibescienceGraph from '../data/vibescience-graph.json';
import SiteLayout from '../layouts/SiteLayout.astro';

const previewNodes = [...vibescienceGraph.nodes]
	.sort((a, b) => b.degree - a.degree)
	.slice(0, 120)
	.map((node) => ({
		id: node.id,
		label: node.label,
		degree: node.degree,
		val: node.size,
		color:
			node.kind === 'diagnostics'
				? '#c28b5a'
				: node.kind === 'experiments'
					? '#c4a15b'
					: node.kind === 'hypotheses'
						? '#8f83c1'
						: node.kind === 'problems'
							? '#c46c6c'
							: node.kind === 'papers'
								? '#6e9eae'
								: '#8b8e97',
		x: node.x,
		y: node.y,
	}));
const previewNodeIds = new Set(previewNodes.map((node) => node.id));
const previewLinks = vibescienceGraph.edges
	.filter((edge) => previewNodeIds.has(edge.source) && previewNodeIds.has(edge.target))
	.map((edge) => ({ source: edge.source, target: edge.target, weight: edge.weight }));
const vibesciencePreviewData = JSON.stringify({ nodes: previewNodes, links: previewLinks }).replace(/</g, '\\u003c');
---

<SiteLayout
	title="Curriculum vitae"
	description={`CV — ${SITE_AUTHOR}`}
	type="profile"
	wide={false}
	atmosphere="blank"
>
	<article class="cv">
		<div class="cv-intro" data-cv-intro>
			<header class="cv-header">
				<div class="portrait-rail">
					<div class="portrait-sticky"><CvPortrait /></div>
				</div>
				<div class="cv-identity">
					<h1>{SITE_AUTHOR}</h1>
					<p class="place">{SITE_LOCATION}</p>
					<div class="chips">
						{
							cvLinks.map((link) => (
								<a
									href={link.href}
									target={link.href.startsWith('mailto:') ? undefined : '_blank'}
									rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
									data-umami-event="cv-contact-click"
									data-umami-event-channel={link.label.toLowerCase()}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</div>
			</header>

			<SectionLabel>Education</SectionLabel>
			<div class="stack">
				{
					education.map((item) => (
						<div class:list={['card', { compact: !item.bullets }]}>
							{item.logo && (
								<img class="education-logo" src={item.logo.src} width={item.logo.width} height={item.logo.height} alt="" />
							)}
							<div class="card__head">
								<h2>{item.title}</h2>
								<span>{item.period}</span>
							</div>
							{item.meta &&
								(item.metaHref ? (
									<p class="meta">
										<a
											href={item.metaHref}
											target="_blank"
											rel="noopener noreferrer"
											data-umami-event="cv-education-click"
											data-umami-event-institution={item.meta.split(' · ')[0]}
										>
											{item.meta.split(' · ')[0]}
										</a>
										{' · '}
										{item.meta.split(' · ').slice(1).join(' · ')}
									</p>
								) : (
									<p class="meta">{item.meta}</p>
								))}
							{item.bullets && (
								<ul>
									{item.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							)}
						</div>
					))
				}
			</div>
		</div>

		<SectionLabel>Projects</SectionLabel>
		<p class="section-note">{cvProjectsNote}</p>
		<div class="projects">
			{cvProjects.map((item, index) => (
				<details class="project" data-cv-project>
					<summary class="project__summary" aria-controls={`project-panel-${index}`}>
						<span class="project__title"><a href={item.href} target={item.href?.startsWith('/') ? undefined : '_blank'}
							rel="noopener noreferrer" data-umami-event="cv-project-click" data-umami-event-project={item.title}>
							{item.title}
						</a></span>
						<span class="project__period">{item.period}</span>
						<span class="project__lede">{item.lede}</span>
						<span class="project__indicator" aria-hidden="true"></span>
					</summary>
					<div class="project__panel" id={`project-panel-${index}`}>
						<ul>{item.bullets.map(bullet => <li set:html={bullet} />)}</ul>
						<div class="project__media">
							{item.image && <img loading="lazy" src={item.image.src} alt={item.image.alt} />}
							{item.preview && <VibesciencePreview data={vibesciencePreviewData} />}
							{item.video && <video controls playsinline preload="none" poster={item.video.poster} aria-label={item.video.label}>
								{item.video.webm && <source src={item.video.webm} type="video/webm" />}
								<source src={item.video.src} type="video/mp4" />
								{item.video.captions?.map(caption => (
									<track
										kind={caption.kind}
										src={caption.src}
										srclang={caption.lang}
										label={caption.label}
										default={caption.default}
									/>
								))}
							</video>}
							{item.videoEmbed && <iframe
								src={item.videoEmbed}
								title={`${item.title} video`}
								loading="lazy"
								referrerpolicy="strict-origin-when-cross-origin"
								allow="fullscreen; picture-in-picture"
							></iframe>}
							{item.diagram && <ol class="project__diagram">{item.diagram.map(step => <li>{step}</li>)}</ol>}
						</div>
					</div>
				</details>
			))}
		</div>

		<SectionLabel>Misc vibe</SectionLabel>
		<div class="stack misc-vibe">
			{
				miscVibeProjects.map((item) => (
					<div class="card">
						<h2>
							<a
								href={item.href}
								target="_blank"
								rel="noopener noreferrer"
								data-umami-event="cv-misc-project-click"
								data-umami-event-project={item.title}
							>
								{item.title}
							</a>
						</h2>
						<p class="lede">{item.lede}</p>
					</div>
				))
			}
		</div>

		<div class="cv-outro" data-cv-outro>
			<div>
				<SectionLabel>Awards</SectionLabel>
				<div class="awards">
					{
						awards.map((item) => (
							<div class="award">
								<span>{item.mark}</span>
								<p>
									<span set:html={item.text} />
									{item.note && <em> — {item.note}</em>}
								</p>
							</div>
						))
					}
				</div>

				<SectionLabel>Skills</SectionLabel>
				<div class="skills">
					{
						skills.map((group) => (
							<div class="skill">
								<p>{group.label}</p>
								<div>
									{group.items.map((item) => (
										<span>{item}</span>
									))}
								</div>
							</div>
						))
					}
				</div>
			</div>
			<div class="pointing-portrait">
				<div class="pointing-track"><CvPortrait variant="pointing" /></div>
			</div>
		</div>
	</article>
</SiteLayout>

<script>
	import '../scripts/cv-portrait';
	import '../scripts/cv-projects';
</script>

<style>
	.cv {
		--cv-top: 72px;
		--portrait-rail-gap: 34px;
		--portrait-gutter-width: calc((100vw - var(--page-max-narrow)) / 2 - var(--portrait-rail-gap) - var(--page-pad-x));
		position: relative;
		padding: var(--cv-top) 0 24px;
	}

	.cv-header {
		display: grid;
		grid-template-columns: clamp(88px, 24vw, 158px) minmax(0, 1fr);
		align-items: center;
		gap: clamp(15px, 3vw, 30px);
	}

	@media screen and (min-width: 1120px) and (min-height: 450px) {
		.cv-header {
			display: block;
		}

		.portrait-rail {
			position: absolute;
			inset-block: var(--cv-top) 24px;
			right: calc(100% + var(--portrait-rail-gap));
			width: clamp(136px, var(--portrait-gutter-width), 238px);
		}

		.portrait-sticky {
			position: sticky;
			top: 28px;
		}

		.portrait-sticky > :global([data-cv-portrait='rail']) {
			--portrait-position: 54% 45%;
			height: var(--portrait-height, auto);
		}
	}

	.section-note {
		margin: 0 0 24px;
		font-size: 13px;
		color: var(--mute);
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.place {
		margin-top: 10px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin-top: 20px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--mute);
	}

	.chips a:hover {
		color: var(--ink);
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.card.compact {
		display: flex;
		align-items: baseline;
		gap: 16px;
	}

	.education-logo {
		display: block;
		width: 88px;
		height: auto;
		margin-bottom: 12px;
	}

	@media screen {
		:global(html[data-theme='dark']) .education-logo {
			filter: brightness(0) invert(1);
		}
	}

	@media screen and (prefers-color-scheme: dark) {
		:global(html:not([data-theme])) .education-logo {
			filter: brightness(0) invert(1);
		}
	}

	.card__head {
		display: flex;
		align-items: baseline;
		gap: 16px;
		flex-wrap: wrap;
	}

	.card h2 {
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.015em;
		flex: 1;
		min-width: 240px;
	}

	.card.compact h2 {
		font-size: 16px;
	}

	.card h2 a {
		border-bottom: 1px solid var(--rule);
	}

	.card h2 a:hover {
		border-bottom-color: var(--ink);
	}

	.card span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--mute);
	}

	.meta {
		font-size: 14px;
		color: var(--mute);
		margin-top: 8px;
	}

	.meta a {
		border-bottom: 1px solid var(--rule);
	}

	.lede {
		font-size: 15px;
		line-height: 1.6;
		margin-top: 10px;
	}

	.projects {
		container-type: inline-size;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 10px;
	}
	.project {
		--expanded-width: max(100cqw, calc(50cqw + 50vw - var(--page-pad-x)));
		box-sizing: border-box;
		width: 100%;
		border-top: 1px solid var(--rule);
		overflow: clip;
		overflow-anchor: none;
	}
	.project[open] {
		width: var(--expanded-width);
	}
	.project__summary {
		box-sizing: border-box;
		width: 100%;
		display: grid;
		/* Give the space revealed by the card to the gap before the date. */
		--date-gap: max(14px, calc(14px + 100% - 100cqw));
		grid-template-columns: minmax(0, 1fr) var(--date-gap) auto 14px 18px;
		grid-template-areas: 'title . period . indicator' 'lede lede lede . indicator';
		align-items: baseline;
		row-gap: 5px;
		padding: 14px 0;
		list-style: none;
		cursor: pointer;
	}
	.project__summary::-webkit-details-marker { display: none; }
	.project__title { grid-area: title; font-size: 17px; font-weight: 500; line-height: 1.35; letter-spacing: -.015em; }
	.project__summary:focus-visible { outline-offset: -2px; }
	.project__title a, .project__panel :global(a) {
		color: var(--ink);
		border: 0;
		text-decoration: underline;
		text-decoration-color: var(--mute);
		text-decoration-thickness: 1px;
		text-underline-offset: .2em;
	}
	.project__title a:hover, .project__panel :global(a:hover) { text-decoration-color: var(--ink); }
	.project__period { grid-area: period; font: 11.5px var(--font-mono); color: var(--mute); }
	.project__lede { grid-area: lede; max-width: calc(100cqw - 32px); font-size: 14px; line-height: 1.5; color: var(--mute); }
	.project__indicator { grid-area: indicator; text-align: center; color: var(--mute); line-height: 1; }
	.project__indicator::before { content: '+'; }
	.project[open] .project__indicator::before { content: '−'; }
	.project__panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, .9fr);
		align-items: start;
		gap: clamp(16px, 2vw, 32px);
		width: var(--expanded-width);
		padding: 16px 0;
		background: color-mix(in srgb, var(--paper) 90%, transparent);
		backdrop-filter: blur(8px);
		border-top: 1px solid var(--rule);
	}
	.project__panel ul { margin: 0; }
	.project__media {
		position: relative;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: 8px;
		border: 1px solid var(--rule);
		background: var(--paper);
		aspect-ratio: 1.6;
	}
	.project__media img, .project__media video { width: 100%; height: 100%; object-fit: contain; min-height: 0; }
	.project__media iframe { width: 100%; height: 100%; min-height: 0; border: 0; }
	.project__media :global(.vibescience-preview) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 1; visibility: visible; transform: none; border: 0; border-radius: 0; }
	.project__diagram { margin: 0; padding: 10px; list-style: none; text-align: center; font: clamp(11px, 1vw, 14px) var(--font-mono); }
	.project__diagram li { width: fit-content; margin: auto; padding: 4px 14px; border: 1px solid var(--rule); border-radius: 5px; }
	.project__diagram li + li { margin-top: 12px; position: relative; }
	.project__diagram li + li::before { content: ''; position: absolute; bottom: 100%; left: 50%; height: 13px; width: 1px; background: var(--mute); }
	@media (max-width: 680px) {
		.project__panel { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 560px) {
		.project__summary {
			grid-template-columns: minmax(0, 1fr) 18px;
			grid-template-areas: 'title indicator' 'period indicator' 'lede lede';
			column-gap: 14px;
		}
		.project__lede { max-width: none; }
	}

	ul {
		margin: 14px 0 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 7px;
		font-size: 14.5px;
		line-height: 1.55;
		color: color-mix(in srgb, var(--ink) 78%, var(--paper));
	}

	ul :global(a) {
		border-bottom: 1px solid var(--rule);
	}

	.awards {
		display: flex;
		flex-direction: column;
	}

	.award {
		display: flex;
		align-items: baseline;
		gap: 20px;
		padding: 14px 0;
		border-top: 1px solid var(--rule);
	}

	.award:last-child {
		border-bottom: 1px solid var(--rule);
	}

	.award span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--mute);
		width: 104px;
		flex: none;
	}

	.award p {
		font-size: 15.5px;
		line-height: 1.55;
		flex: 1;
	}

	.award em {
		font-style: normal;
		color: var(--mute);
	}

	.award :global(a) {
		border-bottom: 1px solid var(--rule);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	@media screen {
		.cv-outro {
			--pointing-width: min(34%, 168px, 30svh);
			position: relative;
			display: grid;
			grid-template-columns: minmax(0, 1fr) var(--pointing-width);
			gap: clamp(12px, 4vw, 24px);
		}

		.pointing-portrait {
			--portrait-position: center 34%;
			position: absolute;
			inset-block: 0;
			inset-inline-end: 0;
			width: var(--pointing-width);
		}

		.pointing-track {
			position: absolute;
			inset-inline: 0;
			inset-block: var(--pointing-start, 45%) 0;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
		}

		.pointing-track > :global([data-cv-portrait='pointing']) {
			position: sticky;
			bottom: max(16px, env(safe-area-inset-bottom));
			flex: none;
		}
	}

	@media screen and (min-width: 1120px) and (min-height: 450px) {
		.cv-outro {
			display: block;
		}

		.pointing-portrait {
			--pointing-height: calc(min(100cqh, var(--portrait-gutter-width) * 1.35) / 1.5);
			inset-inline-start: calc(100% + var(--portrait-rail-gap));
			inset-inline-end: auto;
			width: calc(var(--portrait-gutter-width) / 1.5);
			container-type: size;
		}

		.pointing-track {
			inset-block: var(--pointing-start, 30%) var(--pointing-end, 0px);
		}

		.pointing-track > :global([data-cv-portrait='pointing']) {
			height: var(--pointing-height);
			bottom: 28px;
		}
	}

	.skill {
		display: flex;
		align-items: baseline;
		gap: 20px;
		flex-wrap: wrap;
	}

	.skill p {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--mute);
		width: 108px;
		flex: none;
	}

	.skill div {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
		flex: 1;
		font-size: 14.5px;
	}

	@media (max-width: 720px) {
		.cv {
			--cv-top: 48px;
		}

		.award {
			flex-direction: column;
			gap: 6px;
		}

		.award > span {
			width: auto;
		}

		.skill {
			flex-direction: column;
			align-items: stretch;
			gap: 4px;
		}

		.skill p {
			width: auto;
		}
	}

	@media print {
		.cv {
			--paper: #fff;
			--ink: #111;
			--mute: #555;
			--rule: #ccc;
			--pulse: #111;
			--cv-top: 0px;
		}

		.cv-header {
			display: block;
		}

		.portrait-rail,
		.pointing-portrait {
			display: none;
		}

		.project {
			break-inside: avoid;
		}

		.project { --expanded-width: 100%; overflow: visible; }
		.project::details-content { content-visibility: visible; }
		.project__indicator { display: none; }
	}
</style>
