---
import FormattedDate from '../components/FormattedDate.astro';
import SectionLabel from '../components/SectionLabel.astro';
import {
	SITE_AUTHOR,
	SITE_EMAIL,
	SITE_GITHUB,
	SITE_TELEGRAM,
	SITE_TITLE,
	SITE_X,
	SITE_X_HANDLE,
} from '../consts';
import { cvIntro } from '../data/cv';
import { FALLBACK_HRV, FALLBACK_RESTING_HR, FALLBACK_SLEEP_HOURS } from '../data/metrics';
import { getPublishedPosts } from '../data/nav';
import { featuredWork } from '../data/projects';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = await getPublishedPosts();

const workTitle: Record<string, string> = {
	optihealth: 'optiHealth',
	dreamwalker: 'Dream Walker',
	minebit: 'MineBit',
	sailfish: 'SailfishOS',
};
---

<SiteLayout title={SITE_TITLE} atmosphere="field">
	<section class="identity">
		<h1>{SITE_AUTHOR}</h1>
		<p class="bio">{cvIntro}</p>
		<p class="meta">St. Petersburg · ITMO AI360</p>
		<p class="contacts">
			<a href={`mailto:${SITE_EMAIL}`} data-umami-event="contact-click" data-umami-event-channel="email">{SITE_EMAIL}</a>
			<a href={SITE_X} target="_blank" rel="noopener noreferrer" data-umami-event="contact-click" data-umami-event-channel="x">{SITE_X_HANDLE}</a>
			<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer" data-umami-event="contact-click" data-umami-event-channel="github">GitHub</a>
			<a href={SITE_TELEGRAM} target="_blank" rel="noopener noreferrer" data-umami-event="contact-click" data-umami-event-channel="telegram">Telegram</a>
		</p>
		<p class="bpm" data-bpm>
			resting {FALLBACK_RESTING_HR} · hrv {FALLBACK_HRV} · sleep {FALLBACK_SLEEP_HOURS}
		</p>
	</section>

	<SectionLabel>Work</SectionLabel>
	<ul class="list">
		{
			featuredWork.map((project) => (
				<li>
					<a
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
						data-umami-event="project-click"
						data-umami-event-name={project.id}
					>
						<span class="list__title">{workTitle[project.id] ?? project.title}</span>
						<span class="list__note">{project.summary}</span>
					</a>
				</li>
			))
		}
	</ul>

	<SectionLabel>Writing</SectionLabel>
	{
		posts.length === 0 ? (
			<p class="empty">No posts yet.</p>
		) : (
			<ul class="list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} data-umami-event="article-click" data-umami-event-slug={post.id}>
							<span class="list__title">{post.data.title}</span>
							<span class="list__note">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</a>
					</li>
				))}
			</ul>
		)
	}

</SiteLayout>

<style>
	.identity {
		padding-top: 88px;
		max-width: 36rem;
	}

	h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.4rem, 6vw, 3.4rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.bio {
		margin-top: 22px;
		font-size: 18px;
		line-height: 1.55;
		color: var(--ink);
		max-width: 38ch;
	}

	.meta,
	.contacts,
	.bpm,
	.list__note,
	.empty {
		font-family: var(--font-mono);
		font-size: 12.5px;
		letter-spacing: 0.02em;
		color: var(--mute);
	}

	.list__title {
		min-width: 0;
	}

	a:has(> .list__note) .list__note {
		white-space: nowrap;
	}

	.meta {
		margin-top: 28px;
	}

	.contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin-top: 10px;
	}

	.contacts a:hover {
		color: var(--ink);
	}

	.list {
		list-style: none;
		display: flex;
		flex-direction: column;
		max-width: 40rem;
	}

	.list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 12px 28px;
		align-items: baseline;
		padding: 11px 0;
		border-top: 1px solid var(--rule);
		color: var(--ink);
	}

	.list li:last-child a {
		border-bottom: 1px solid var(--rule);
	}

	.list__title {
		font-size: 16px;
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	.list a:hover .list__title {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.empty {
		padding: 8px 0;
	}

	.bpm {
		margin-top: 18px;
	}

	@media (max-width: 720px) {
		.identity {
			padding-top: 48px;
		}

		.list a {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
